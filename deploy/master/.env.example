# XrayPanel 主控机编排示例（复制为 .env 后按环境修改；带 - 的变量有默认值，可省略）
#
# 四端口模型（2026-08-24 拍板）：SPA 前端 / 后端 API / 节点 WS 网关 / 订阅 四个监听端口
# 默认仅绑定宿主机回环 127.0.0.1，TLS 终止与域名/路径分流由用户自备的反代承担
# （参考模板见 Caddyfile.reference / deploy/master/Caddyfile）。
#
# 压缩包挂载形态：release 解压到宿主目录，master / web/dist / configs / data 全部挂载进容器。
# data 目录（SQLite + JWT + 备份）需属主为容器内 app 用户（uid 1000）才能写入：
#   sudo chown -R 1000:1000 data

# ---- 绑定地址与端口（默认仅本机反代可达；改 BIND_ADDR=0.0.0.0 可跨机转发，注意自行收紧防火墙） ----
BIND_ADDR=127.0.0.1
APP_PORT=18080            # SPA 前端
APP_API_PORT=18081        # 后端 HTTP API + /healthz /readyz
APP_WS_PORT=18082         # 节点 WebSocket 网关
APP_SUB_PORT=6000         # 订阅独立端口（0=禁用订阅服务；设为 0 时请同时删除 compose 中对应的 ports 行）

# ---- 公网地址 ----
APP_PUBLIC_URL=https://panel.example.com        # 面板域名（生成节点一键安装命令用 wss://）
APP_WS_PUBLIC_URL=                               # 节点 WS 对外地址；留空=面板域名 + /node/ws
                                                 # 例：wss://ws.example.com/node/ws（独立域名/任意路径）
APP_ENV=prod

# JWT_SECRET：留空=首次启动自动生成 64 位强随机密钥并持久化到 DB（推荐，避免弱密钥）
# 如需显式指定：JWT_SECRET=$(openssl rand -hex 32)

# ---- 初始管理员（不提供默认账密，防默认密码攻击） ----
# 留空=首次启动自动生成 16 位强随机密码并在控制台高亮显示（docker compose logs master）
# 显式指定：ADMIN_USERNAME=admin
#           ADMIN_PASSWORD=<强密码>

# ---- 备份（可选，默认每天 03:00 保留 14 份到数据卷） ----
BACKUP_ENABLED=1
BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP=14