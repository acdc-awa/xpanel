# 复制为 .env 并修改所有密码（生产必改）
# JWT 签名密钥（>=32 字符，用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-at-least-32-chars-random-string

# 首次启动自动创建的初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Caddy 站点地址：有域名用 panel.example.com（自动 HTTPS）；
# 无域名可用 IP:端口（如 1.2.3.4:80）或 :80（仅 HTTP）
SITE_ADDRESS=:80
