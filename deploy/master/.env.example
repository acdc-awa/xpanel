# 复制为 .env 并按需修改
# 运行环境：prod 关闭 gin debug 日志；本地联调可改 dev
APP_ENV=prod

# Caddy 站点地址：
# 有域名填写 panel.example.com（Caddy 自动申请与续签免费 Let's Encrypt HTTPS 证书）；
# 无域名可用 IP:端口（如 1.2.3.4:80）或 :80（仅 HTTP）
SITE_ADDRESS=:80

# --------------------------------------------------------------------------
# 以下配置均为【可选项】（系统默认全自动安全初始化，开箱即用）：
# --------------------------------------------------------------------------
# JWT_SECRET: 留空则系统在首次建库时自动通过 crypto/rand 生成 64 位强随机密钥持久化于 DB
# JWT_SECRET=

# ADMIN_USERNAME: 初始管理员账号（默认 admin@panel.local）
# ADMIN_USERNAME=admin@panel.local

# ADMIN_PASSWORD: 留空则系统首次启动自动生成 16 位强随机密码并在控制台高亮输出
# ADMIN_PASSWORD=
