# 固定运行时镜像（压缩包挂载形态专用）
#
# 与 Dockerfile（源码构建、产物 COPY 进镜像）不同，本镜像只提供运行环境，不含任何业务代码：
#   - ca-certificates / tzdata：TLS 证书与时区（生产必需）
#   - wget：healthcheck 探针（与 restore.sh 一致）
#   - entrypoint：PID 1 包装（master 原生启动 + 更新失败回滚），不含守护进程
#   - app 用户（uid 1000）：宿主目录挂载的数据需 chown 给 1000 才能写入
#
# 用法：docker build -f Dockerfile.runtime -t xpanel-master-runtime:latest .
# 升级/回滚只替换挂载目录里的 master + web/dist，本镜像构建一次即可，不随版本变。
FROM alpine:3.20

# apk 源默认 dl-cdn.alpinelinux.org（国内直连常卡死）；换阿里云镜像。
# 若部署机仍需离线安装，可自行在执行前 COPY pkgs + --allow-untrusted（见 commit 说明）。
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories && \
    apk add --no-cache ca-certificates tzdata wget && \
    adduser -D app

WORKDIR /app
# entrypoint 放 /usr/local/bin 而非 /app：compose 把宿主整目录 bind mount 到 /app，
# 挂载会完全遮蔽镜像内的 /app（含镜像内文件）——放 /app 下运行时必然 stat 不到。
COPY deploy/master/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# 挂载点约定（与 docker-compose.yml 对应，目录挂载 rw 供面板内更新替换）：
#   .               → /app               (rw；master / web / .update-pending / .prev)
#   ./configs       → /app/configs       (ro；配置文件不被更新流程触碰)
#   ./data          → /app/data          (rw, chown 1000)

USER app
EXPOSE 18080 18082 6000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["-config", "/app/configs/config.yaml"]
